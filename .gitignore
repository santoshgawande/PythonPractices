# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtualenvs — never commit these. Install from the manifest instead.
.venv/
venv/
env/
ENV/
myenv/
virtualenv/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — .env.example is the one that gets committed
.env
.env.*
!.env.example

# Node, where a repo has a JS side
node_modules/

# Editors / OS
.vscode/
.idea/
.DS_Store
